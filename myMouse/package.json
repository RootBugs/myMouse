{
  "name": "mymouse",
  "version": "0.1.0",
  "private": true,
  "description": "myMouse - a local-first software KVM alternative",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "test": "vitest",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-two-instances.ps1",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-windows.ps1"
  },
  "build": {
    "appId": "com.mymouse.desktop",
    "productName": "myMouse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/target/release/mymouse-backend.exe",
        "to": "mymouse-backend.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true
  }
}
