<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/status_scaffold" />

    <Button android:id="@+id/btnPairing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/pairing_title" />
    <Button android:id="@+id/btnTrusted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trusted_devices" />
    <Button android:id="@+id/btnFiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/file_transfer" />
    <Button android:id="@+id/btnRemote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/remote_screen" />
    <Button android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings" />
</LinearLayout>
