<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pairing_title" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />
        <TextView android:id="@+id/pairingState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Scan a QR code or enter the 6-digit code shown by the host." />

        <Button android:id="@+id/btnScanQr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/scan_qr" />

        <EditText android:id="@+id/codeInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="123456" android:inputType="number" android:maxLength="6" />

        <EditText android:id="@+id/hostIdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Host device id (from QR or manual)" android:inputType="text" />

        <Button android:id="@+id/btnSubmitCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enter_code" />
        <Button android:id="@+id/btnApprove" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/approve_pairing" />

        <TextView android:id="@+id/pairingResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="" />
    </LinearLayout>
</ScrollView>
