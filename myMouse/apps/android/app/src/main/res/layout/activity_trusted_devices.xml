<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/trusted_devices" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />
    <TextView android:id="@+id/trustedEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No trusted devices yet. Pairing will store devices locally with per-capability toggles." />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/trustedList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" />
</LinearLayout>
